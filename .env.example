# Copy to ".env" in the project root and fill in your token.
# Get a token: https://huggingface.co/settings/tokens
# Read access is enough for public models/datasets.

HF_TOKEN=hf_your_token_here

# Stability AI Platform (Erase API). https://platform.stability.ai/account/keys
STABILITY_API_KEY=sk-your_key_here
